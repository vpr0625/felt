rules_version = '2';

// Security rules for the Felt league.
// Anyone with the app can sign in anonymously, but only league members can see a league's results,
// players can only add and edit their own results, and reactions can only change your own reaction.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function leaguePath(code) { return /databases/$(database)/documents/leagues/$(code); }
    function isMember(code) { return exists(/databases/$(database)/documents/leagues/$(code)/members/$(request.auth.uid)); }
    function isOrganizer(code) { return get(leaguePath(code)).data.createdBy == request.auth.uid; }
    function money(v) { return v is int && v >= 0 && v <= 10000000; }
    function validResult(d) {
      return money(d.buyIn) && money(d.cashOut)
        && d.player is string && d.player.size() > 0 && d.player.size() <= 24
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /leagues/{code} {
      // Knowing the code is what lets you find a league, so leagues can't be listed or browsed.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 32;
      allow update: if signedIn() && isOrganizer(code)
        && request.resource.data.createdBy == resource.data.createdBy;
      // only the organizer can delete a league (the app deletes its results and members first)
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn() && isMember(code);
        // claims: imported names (lowercase) this member has linked to themselves
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && (!('claims' in request.resource.data) || (request.resource.data.claims is list && request.resource.data.claims.size() <= 10));
        // the organizer can undo someone's claim, and change nothing else
        allow update: if signedIn() && isOrganizer(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claims'])
          && request.resource.data.claims is list;
        // you can leave; the organizer can remove members when deleting the league
        allow delete: if signedIn() && (request.auth.uid == uid || isOrganizer(code));
      }

      // League GIF pack: small details in "gifs", the image itself in "gifdata" (same ID)
      match /gifs/{gifId} {
        allow read: if signedIn() && isMember(code);
        allow create: if signedIn() && isMember(code)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'by', 'w', 'h', 'size', 'createdAt'])
          && request.resource.data.by is string && request.resource.data.by.size() <= 24;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOrganizer(code));
      }
      match /gifdata/{gifId} {
        allow read: if signedIn() && isMember(code);
        allow create: if signedIn() && isMember(code)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'type', 'data'])
          && request.resource.data.type in ['image/gif', 'image/webp', 'image/png', 'image/jpeg']
          && request.resource.data.data is string && request.resource.data.data.size() <= 700000;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOrganizer(code));
      }

      match /results/{resultId} {
        allow read: if signedIn() && isMember(code);
        allow create: if signedIn() && isMember(code)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.reactions == {}
          && validResult(request.resource.data);
        allow update: if signedIn() && isMember(code) && (
          // your own result: change the date, amounts or your name on it
          (resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'buyIn', 'cashOut', 'player'])
            && validResult(request.resource.data))
          ||
          // anyone's result: add, change or remove only your own reaction
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]))
        );
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOrganizer(code));
      }
    }
  }
}
